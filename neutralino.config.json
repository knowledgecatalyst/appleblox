{
	"applicationId": "ch.origaming.appleblox",
	"version": "0.1.0",
	"defaultMode": "window",
	"documentRoot": "/frontend/dist",
	"url": "/",
	"enableServer": true,
	"enableNativeAPI": true,
	"nativeAllowList": [
		"events.on", "events.off", "events.broadcast", "events.dispatch",
		"os.execCommand", "os.spawnProcess", "os.updateSpawnedProcess",
		"os.open", "os.getEnv", "os.getPath",
		"os.showOpenDialog", "os.showFolderDialog",
		"filesystem.readFile", "filesystem.writeFile", "filesystem.writeBinaryFile",
		"filesystem.appendFile", "filesystem.createDirectory", "filesystem.readDirectory",
		"filesystem.remove", "filesystem.copy", "filesystem.getStats",
		"filesystem.createWatcher", "filesystem.removeWatcher",
		"window.show",
		"clipboard.writeText",
		"computer.getOSInfo", "computer.getCPUInfo", "computer.getMemoryInfo", "computer.getDisplays",
		"app.writeProcessOutput", "app.readProcessInput", "app.exit", "app.getConfig"
	],
	"exportAuthInfo": false,
	"logging": {
		"writeToLogFile": false,
		"enabled": true
	},
	"tokenSecurity": "one-time",
	"modes": {
		"window": {
			"hidden": true,
			"title": "AppleBlox",
			"width": 1150,
			"height": 700,
			"minWidth": 400,
			"minHeight": 200,
			"icon": "/scripts/build/assets/mac.png",
			"exitProcessOnClose": false,
			"useSavedState": false,
			"extendUserAgentWith": "AppleBlox",
			"resizable": false,
			"center": true
		},
		"chrome": {
			"width": 1150,
			"height": 700
		}
	},
	"cli": {
		"binaryName": "appleblox",
		"resourcesPath": "/frontend/dist",
		"extensionsPath": "/extensions/",
		"binaryVersion": "5.1.0",
		"clientVersion": "3.12.0",
		"frontendLibrary": {
			"buildCommand": "true",
			"patchFile": "/frontend/index.html",
			"devUrl": "http://localhost:5173",
			"devCommand": "true",
			"projectPath": "/",
			"initCommand": "bun install"
		}
	}
}
